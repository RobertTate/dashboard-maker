{
  "name": "dashboard-maker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:live": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "announcements:pull": "node scripts/pull-announcements.mjs",
    "preview": "vite preview",
    "format:css": "prettier --write **/*.css && stylelint **/*.css --fix",
    "format:all": "prettier . --write",
    "prepare": "husky"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.9"
    }
  },
  "dependencies": {
    "@3d-dice/dice-box": "^1.0.12",
    "@3d-dice/dice-parser-interface": "^0.2.1",
    "@3d-dice/dice-ui": "https://github.com/RobertTate/dice-ui.git",
    "@mdxeditor/editor": "^4.0.4",
    "@mdxeditor/gurx": "^1.2.4",
    "@owlbear-rodeo/sdk": "^3.1.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@vercel/analytics": "^1.3.1",
    "@vercel/speed-insights": "^1.0.12",
    "ajv": "^8.12.0",
    "classnames": "^2.5.1",
    "localforage": "^1.10.0",
    "lodash.debounce": "^4.0.8",
    "lodash.isequal": "^4.5.0",
    "pako": "^2.1.0",
    "radix-ui": "^1.4.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-grid-layout": "^1.4.3",
    "react-hook-form": "^7.82.0",
    "short-unique-id": "^5.0.3"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/lodash.isequal": "^4.5.8",
    "@types/pako": "^2.0.3",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/react-grid-layout": "^1.3.5",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "husky": "^9.1.7",
    "prettier": "3.1.0",
    "stylelint": "^15.11.0",
    "stylelint-config-concentric-order": "^5.2.0",
    "stylelint-config-standard": "^34.0.0",
    "typescript": "^5.0.2",
    "vite": "^6.2.2",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^4.1.10"
  }
}
