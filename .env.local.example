# Credentials for scripts/pull-announcements.mjs (npm run announcements:pull).
# Copy to .env.local (gitignored) and fill in from your Patreon OAuth client:
# https://www.patreon.com/portal/registration/register-clients
#
# The script rewrites the two tokens below on refresh — only run it from
# one machine (see the comment at the top of the script).
PATREON_ACCESS_TOKEN=
PATREON_REFRESH_TOKEN=
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
